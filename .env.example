# Any OpenAI-compatible provider — swap LLM_MODEL to change the model
# (e.g. glm-5.3-flash-free, mimo-v2.6-flash-free on the OpenCode gateway)
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/inference/v1
LLM_MODEL=glm-5.3-flash-free

# Optional tuning
TEMPERATURE=0.2
MAX_LLM_RETRIES=4
MAX_BROWSER_CALLS=120
CLI_TIMEOUT_SECONDS=60
SCOUT_MAX_ITER=8
OPERATOR_MAX_ITER=25
DB_PATH=browseragent.db
